[Unit]
Description=SIMA personal investment PWA
After=network.target

[Service]
User=sima-web
Group=sima-web
WorkingDirectory=/opt/sima-pwa/current
EnvironmentFile=/etc/sima-pwa.env
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/opt/sima-pwa/current/.venv/bin/gunicorn --bind 127.0.0.1:8765 --workers 1 --threads 2 --timeout 30 --error-logfile - src.mobile_app:create_app()
Restart=on-failure
RestartSec=5
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/sima-pwa
BindReadOnlyPaths=/home/ubuntu/sima/logs:/var/lib/sima-pwa/data
RestrictSUIDSGID=true
CapabilityBoundingSet=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
MemoryMax=256M
CPUQuota=30%

[Install]
WantedBy=multi-user.target
